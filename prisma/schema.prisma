// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  OWNER
  STAFF
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

model Organization {
  id           String               @id @default(cuid())
  name         String
  slug         String               @unique
  category     String
  timezone     String               @default("America/Argentina/Buenos_Aires")
  currency     String               @default("ARS")
  address      String?
  phone        String?
  email        String?
  location     String?
  scheduleText String?
  rating       Float?
  reviewCount  Int                  @default(0)
  createdAt    DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime             @updatedAt @db.Timestamptz(3)
  memberships  Membership[]
  staff        Staff[]
  services     Service[]
  availability WeeklyAvailability[]
  timeOff      TimeOff[]
  appointments Appointment[]
}

model User {
  id           String       @id @default(cuid())
  name         String
  email        String       @unique
  passwordHash String
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(3)
  memberships  Membership[]
  staffProfile Staff?
  sessions     Session[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Membership {
  id             String         @id @default(cuid())
  role           MembershipRole @default(STAFF)
  userId         String
  organizationId String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Staff {
  id             String               @id @default(cuid())
  displayName    String
  bio            String?
  roleTitle       String?
  initials        String?
  accent          String?
  active         Boolean              @default(true)
  archivedAt     DateTime?            @db.Timestamptz(3)
  userId         String?              @unique
  organizationId String
  user           User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  services       StaffService[]
  availability   WeeklyAvailability[]
  timeOff        TimeOff[]
  appointments   Appointment[]

  @@index([organizationId, active])
  @@index([organizationId, archivedAt])
}

model Service {
  id              String         @id @default(cuid())
  name            String
  description     String?
  durationMinutes Int
  priceInCents    Int
  active          Boolean        @default(true)
  sortOrder       Int            @default(0)
  organizationId  String
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  staff           StaffService[]
  appointments    Appointment[]

  @@index([organizationId, active])
}

model StaffService {
  staffId   String
  serviceId String
  staff     Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([staffId, serviceId])
}

model WeeklyAvailability {
  id             String       @id @default(cuid())
  weekday        Int
  startTime      String
  endTime        String
  staffId        String?
  organizationId String
  staff          Staff?       @relation(fields: [staffId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, weekday])
  @@index([staffId, weekday])
}

model TimeOff {
  id             String       @id @default(cuid())
  reason         String?
  startAt        DateTime     @db.Timestamptz(3)
  endAt          DateTime     @db.Timestamptz(3)
  staffId        String?
  organizationId String
  staff          Staff?       @relation(fields: [staffId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, startAt, endAt])
  @@index([staffId, startAt, endAt])
}

model Appointment {
  id             String            @id @default(cuid())
  status         AppointmentStatus @default(CONFIRMED)
  startAt        DateTime          @db.Timestamptz(3)
  endAt          DateTime          @db.Timestamptz(3)
  customerName   String
  customerEmail  String
  customerPhone  String
  notes          String?
  cancelToken    String            @unique
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(3)
  organizationId String
  serviceId      String
  staffId        String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  service        Service           @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  staff          Staff             @relation(fields: [staffId], references: [id], onDelete: Restrict)

  @@index([organizationId, startAt])
  @@index([staffId, startAt, endAt])
  @@index([customerEmail, startAt])
}
